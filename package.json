{
  "name": "picture-kkokkok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/content.mjs export && node scripts/prepare-content-review.mjs && node scripts/ipad-address.mjs && vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:ipad": "npm run dev",
    "check": "tsc --noEmit && node scripts/content.mjs check",
    "test": "vitest run",
    "build": "npm run check && node scripts/content.mjs export && vite build && node scripts/content.mjs audit",
    "preview": "vite preview --host 127.0.0.1",
    "content": "node scripts/content.mjs",
    "batch": "node scripts/content.mjs batch",
    "deploy": "node scripts/deploy.mjs",
    "release:check": "node scripts/content.mjs release-check",
    "test:browser": "playwright test",
    "test:preview": "node scripts/content.mjs export && vite build --mode test && vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
